# Postgres
DB_HOST=db
DB_PORT=5432
DB_USER=langfuse
DB_PASSWORD=ChangeMe123456
DB_NAME=langfuse
DATABASE_URL=postgresql://langfuse:ChangeMe123456@db:5432/langfuse

# ClickHouse V3必填两个URL
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=ChangeMeCH123456
CLICKHOUSE_DB=langfuse

# Redis V3需要连接字符串
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CONNECTION_STRING=redis://redis:6379

# MinIO S3存储（V3强制必须要有）
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse-events
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY=minioadmin
LANGFUSE_S3_EVENT_UPLOAD_SECRET_KEY=miniosecret
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true

# Auth安全配置
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

LANGFUSE_INIT_EMAIL=admin@example.com
LANGFUSE_INIT_PASSWORD=Admin@123456

TELEMETRY_ENABLED=false
